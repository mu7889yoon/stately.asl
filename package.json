{
  "name": "stately",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "examples",
    "test"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -t run build",
    "dev": "yarn workspaces foreach -A run dev",
    "test": "yarn build && vitest run",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "packageManager": "yarn@4.10.3",
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
