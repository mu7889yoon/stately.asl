{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@stately/types": ["packages/types/src"],
      "@stately/core": ["packages/core/src"],
      "@stately/plugins/*": ["packages/plugins/src/*"]
    }
  }
}

