// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`transpile ddb-put-item > produces ASL Task for PutItem 1`] = `
{
  "StartAt": "putItem_1",
  "States": {
    "putItem_1": {
      "End": true,
      "Parameters": {
        "Item.$": "$.Item",
        "TableName.$": "$.TableName",
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
      "ResultPath": "$.putItem_1Result",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "States.ALL",
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
        },
      ],
      "Type": "Task",
    },
  },
}
`;
