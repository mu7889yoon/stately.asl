// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`transpile ddb-batch > produces Parallel/Map/Catch-like 1`] = `
{
  "StartAt": "Parallel_1",
  "States": {
    "Map_1": {
      "ItemsPath": "$.items",
      "Iterator": {
        "StartAt": "putItem_3",
        "States": {
          "putItem_3": {
            "End": true,
            "Parameters": {
              "Item.$": "$.Item",
              "TableName.$": "$.TableName",
            },
            "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
            "ResultPath": "$.putItem_3Result",
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "States.ALL",
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
              },
            ],
            "Type": "Task",
          },
        },
      },
      "Next": "putItem_5",
      "ResultPath": undefined,
      "Type": "Map",
    },
    "Parallel_1": {
      "Branches": [
        {
          "StartAt": "putItem_1",
          "States": {
            "putItem_1": {
              "End": true,
              "Parameters": {
                "Item.$": "$.Item",
                "TableName.$": "$.TableName",
              },
              "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
              "ResultPath": "$.putItem_1Result",
              "Retry": [
                {
                  "BackoffRate": 2,
                  "ErrorEquals": [
                    "States.ALL",
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 3,
                },
              ],
              "Type": "Task",
            },
          },
        },
      ],
      "Next": "Map_1",
      "ResultPath": undefined,
      "Type": "Parallel",
    },
    "Pass_1": {
      "End": true,
      "Type": "Pass",
    },
    "putItem_5": {
      "Next": "Pass_1",
      "Parameters": {
        "Item.$": "$.items[0]",
        "TableName.$": "$.TableName",
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
      "ResultPath": "$.putItem_5Result",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "States.ALL",
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
        },
      ],
      "Type": "Task",
    },
  },
}
`;
