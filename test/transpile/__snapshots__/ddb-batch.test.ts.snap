// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`transpile ddb-batch > produces Parallel/Map/Catch-like 1`] = `
{
  "QueryLanguage": "JSONata",
  "StartAt": "Map_1",
  "States": {
    "Map_1": {
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE",
        },
        "StartAt": "putItem_1",
        "States": {
          "putItem_1": {
            "Arguments": {
              "Item": "{% $states.input.Item %}",
              "TableName": "{% $states.input.TableName %}",
            },
            "End": true,
            "Output": "{% $merge([$states.input, {"putItem_1Result": $states.result}]) %}",
            "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "States.ALL",
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
              },
            ],
            "Type": "Task",
          },
        },
      },
      "ItemSelector": "{% $merge([$states.input, {"Item": $states.context.Map.Item.Value}]) %}",
      "Items": "{% $states.input.items %}",
      "Next": "Map_2",
      "Output": "{% $merge([$states.input, {"Map_1Result": $states.result}]) %}",
      "Type": "Map",
    },
    "Map_2": {
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE",
        },
        "StartAt": "putItem_2",
        "States": {
          "putItem_2": {
            "Arguments": {
              "Item": "{% $states.input.Item %}",
              "TableName": "{% $states.input.TableName %}",
            },
            "End": true,
            "Output": "{% $merge([$states.input, {"putItem_2Result": $states.result}]) %}",
            "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "States.ALL",
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
              },
            ],
            "Type": "Task",
          },
        },
      },
      "ItemSelector": "{% $merge([$states.input, {"Item": $states.context.Map.Item.Value}]) %}",
      "Items": "{% $states.input.items %}",
      "MaxConcurrency": 1,
      "Next": "putItem_3",
      "Output": "{% $merge([$states.input, {"Map_2Result": $states.result}]) %}",
      "Type": "Map",
    },
    "Pass_1": {
      "End": true,
      "Output": {
        "ok": false,
      },
      "Type": "Pass",
    },
    "Pass_2": {
      "Next": "Pass_3",
      "Type": "Pass",
    },
    "Pass_3": {
      "End": true,
      "Output": {
        "ok": true,
      },
      "Type": "Pass",
    },
    "putItem_3": {
      "Arguments": {
        "Item": "{% $states.input.items[0] %}",
        "TableName": "{% $states.input.TableName %}",
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL",
          ],
          "Next": "Pass_1",
          "Output": "{% $merge([$states.input, {"error": $states.errorOutput}]) %}",
        },
      ],
      "Next": "Pass_2",
      "Output": "{% $merge([$states.input, {"putItem_3Result": $states.result}]) %}",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "States.ALL",
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
        },
      ],
      "Type": "Task",
    },
  },
}
`;
