// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`transpile ddb-batch > produces Parallel/Map/Catch-like 1`] = `
{
  "QueryLanguage": "JSONata",
  "StartAt": "Parallel_1",
  "States": {
    "Map_1": {
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE",
        },
        "StartAt": "putItem_2",
        "States": {
          "putItem_2": {
            "Arguments": {
              "Item": "{% $states.input.Item %}",
              "TableName": "{% $states.input.TableName %}",
            },
            "End": true,
            "Output": "{% $merge([$states.input, {"putItem_2Result": $states.result}]) %}",
            "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "States.ALL",
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
              },
            ],
            "Type": "Task",
          },
        },
      },
      "ItemSelector": "{% $merge([$states.input, {"Item": $states.context.Map.Item.Value}]) %}",
      "Items": "{% $states.input.items %}",
      "Next": "putItem_3",
      "Output": "{% $merge([$states.input, {"Map_1Result": $states.result}]) %}",
      "Type": "Map",
    },
    "Parallel_1": {
      "Branches": [
        {
          "QueryLanguage": "JSONata",
          "StartAt": "putItem_1",
          "States": {
            "putItem_1": {
              "Arguments": {
                "Item": "{% $states.input.Item %}",
                "TableName": "{% $states.input.TableName %}",
              },
              "End": true,
              "Output": "{% $merge([$states.input, {"putItem_1Result": $states.result}]) %}",
              "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
              "Retry": [
                {
                  "BackoffRate": 2,
                  "ErrorEquals": [
                    "States.ALL",
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 3,
                },
              ],
              "Type": "Task",
            },
          },
        },
      ],
      "Next": "Map_1",
      "Output": "{% $merge([$states.input, {"Parallel_1Result": $states.result}]) %}",
      "Type": "Parallel",
    },
    "Pass_1": {
      "End": true,
      "Type": "Pass",
    },
    "putItem_3": {
      "Arguments": {
        "Item": "{% $states.input.items[0] %}",
        "TableName": "{% $states.input.TableName %}",
      },
      "Next": "Pass_1",
      "Output": "{% $merge([$states.input, {"putItem_3Result": $states.result}]) %}",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "States.ALL",
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
        },
      ],
      "Type": "Task",
    },
  },
}
`;
